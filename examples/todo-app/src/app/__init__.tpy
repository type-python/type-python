# Todo App
#
# Demonstrates: data class, TypedDict, strict null safety, type narrowing.
#
# Run: typepython check --project examples/todo-app

from typing import TypedDict


# --- Data classes -------------------------------------------------------------

data class Todo:
    title: str
    done: bool = False
    priority: str = "medium"

data class TodoList:
    name: str
    items: list[Todo]


# --- TypedDict for API payloads ----------------------------------------------

class CreateTodoRequest(TypedDict):
    title: str
    priority: str

class TodoResponse(TypedDict, total=False):
    id: int
    title: str
    done: bool
    priority: str
    error: str


# --- Lookup ------------------------------------------------------------------

def find_todo(todos: list[Todo], key: str) -> Todo | None:
    """Find a todo by title."""
    for todo in todos:
        if todo.title == key:
            return todo
    return None


# --- Null-safe operations -----------------------------------------------------

def complete(todos: list[Todo], title: str) -> str:
    """Mark a todo as done. Demonstrates null narrowing."""
    todo: Todo | None = None
    for item in todos:
        if item.title == title:
            todo = item

    # todo is Todo | None here -- accessing .done would be an error.
    if todo is None:
        return f"'{title}' not found"

    # todo is narrowed to Todo here.
    if todo.done:
        return f"'{todo.title}' is already done"
    return f"'{todo.title}' marked as done"


def summary(todo_list: TodoList) -> str:
    """Summarize a todo list."""
    total = 0
    done = 0
    for item in todo_list.items:
        total = total + 1
        if item.done:
            done = done + 1
    return f"{todo_list.name}: {done}/{total} completed"


# --- Filter with union narrowing ---------------------------------------------

def filter_todos(todos: list[Todo], by: str | None) -> list[Todo]:
    """Filter todos by different criteria using union narrowing."""
    if by is None:
        return todos
    result: list[Todo] = []
    for t in todos:
        if t.title == by:
            result.append(t)
    return result
