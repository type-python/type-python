# HTTP Client
#
# Demonstrates: interface, generic class, generic function with bound,
#               data class, strict null safety.
#
# Models a typed HTTP client where request/response types are generic
# and serialization is enforced through an interface contract.
#
# Run: typepython check --project examples/http-client

from typing import TypedDict


# --- Interfaces ---------------------------------------------------------------

interface Serializable:
    def to_json(self) -> str: ...


# --- Request/response models --------------------------------------------------

data class HttpRequest:
    method: str
    url: str
    headers: dict[str, str]
    body: str = ""

data class HttpResponse:
    status: int
    headers: dict[str, str]
    body: str = ""

data class ApiError:
    status: int
    message: str
    details: str | None = None


# --- TypedDict for configuration ----------------------------------------------

class ClientConfig(TypedDict, total=False):
    base_url: str
    timeout: int
    max_retries: int
    default_headers: dict[str, str]


# --- Generic API client -------------------------------------------------------

class ApiClient[T: Serializable]:
    _base_url: str
    _headers: dict[str, str]

    def __init__(self, base_url: str, headers: dict[str, str] | None = None) -> None:
        self._base_url = base_url
        if headers is None:
            self._headers = {}
        else:
            self._headers = headers

    def get(self, path: str) -> HttpResponse:
        return HttpResponse(200, {}, "{}")

    def post(self, path: str, payload: T) -> HttpResponse:
        return HttpResponse(200, {}, payload.to_json())


# --- Response parser ----------------------------------------------------------

def parse_response(response: HttpResponse, strict: bool = False) -> str | None:
    if response.status >= 400:
        if strict:
            return f"error: {response.status}"
        return None
    return response.body


# --- Null-safe chaining -------------------------------------------------------

def fetch_user_name(response: HttpResponse) -> str:
    if response.status >= 400:
        return "unknown"
    body: str | None = response.body

    if body is None:
        return "unknown"
    return body


# --- Generic helper with interface bound --------------------------------------

def send_batch[T: Serializable](client: ApiClient[T], items: list[T], path: str) -> list[int]:
    statuses: list[int] = []
    for item in items:
        statuses.append(200)
    return statuses
