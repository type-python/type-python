# Shapes
#
# Demonstrates: sealed class, match exhaustiveness, data class,
#               interface, generic function.
#
# The compiler proves that every match statement covers all sealed
# subclasses. Adding a new shape without updating the match will
# produce a TPY4009 diagnostic at compile time.
#
# Run: typepython check --project examples/shapes

# --- Interface: any shape must be drawable ------------------------------------

interface Drawable:
    def draw(self) -> str: ...


# --- Sealed class hierarchy ---------------------------------------------------

sealed class Shape:
    pass

data class Circle(Shape):
    radius: float

data class Rectangle(Shape):
    width: float
    height: float

data class Triangle(Shape):
    base: float
    height: float


# --- Exhaustive pattern matching ----------------------------------------------

def area(shape: Shape) -> float:
    """Compute the area."""
    if isinstance(shape, Circle):
        return shape.radius * shape.radius
    if isinstance(shape, Rectangle):
        return shape.width * shape.height
    if isinstance(shape, Triangle):
        return shape.base * shape.height / float(2)
    return float(0)


def perimeter(shape: Shape) -> float:
    if isinstance(shape, Circle):
        return float(2) * float(3) * shape.radius
    if isinstance(shape, Rectangle):
        return float(2) * (shape.width + shape.height)
    if isinstance(shape, Triangle):
        return shape.base + float(2) * shape.height
    return float(0)


def describe(shape: Shape) -> str:
    """Describe the shape. This match is proven exhaustive."""
    match shape:
        case Circle(radius=r):
            return "circle"
        case Rectangle(width=w, height=h):
            return "rectangle"
        case Triangle(base=b, height=h):
            return "triangle"


# --- Generic utility ----------------------------------------------------------

def largest[T: Shape](shapes: list[T]) -> T | None:
    """Return the first shape in a generic collection."""
    if len(shapes) == 0:
        return None
    return shapes[0]


# --- Combining features -------------------------------------------------------

def report(shapes: list[Shape]) -> list[str]:
    """Generate a human-readable report for a list of shapes."""
    lines: list[str] = []
    for shape in shapes:
        if isinstance(shape, Circle):
            shape_area = shape.radius * shape.radius
            shape_perimeter = float(2) * float(3) * shape.radius
            lines.append(f"circle: area={shape_area}, perimeter={shape_perimeter}")
        if isinstance(shape, Rectangle):
            shape_area = shape.width * shape.height
            shape_perimeter = float(2) * (shape.width + shape.height)
            lines.append(f"rectangle: area={shape_area}, perimeter={shape_perimeter}")
        if isinstance(shape, Triangle):
            shape_area = shape.base * shape.height / float(2)
            shape_perimeter = shape.base + float(2) * shape.height
            lines.append(f"triangle: area={shape_area}, perimeter={shape_perimeter}")
    return lines
