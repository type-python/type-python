{
  "fixtures": [
    {
      "name": "basic-package",
      "targets": ["3.10"]
    },
    {
      "name": "rich-package",
      "targets": ["3.10", "3.12"]
    },
    {
      "name": "standard-typing-package",
      "targets": ["3.10", "3.12"],
      "expected_stub_fragments": {
        "3.10": [
          "class JsonRecord(TypedDict)",
          "def consume(renderable: Renderable) -> str: ...",
          "def merge_records(left: JsonRecord, right: JsonRecord) -> JsonRecord: ..."
        ],
        "3.12": [
          "class JsonRecord(TypedDict)",
          "def consume(renderable: Renderable) -> str: ...",
          "def merge_records(left: JsonRecord, right: JsonRecord) -> JsonRecord: ..."
        ]
      }
    },
    {
      "name": "compat-package",
      "targets": ["3.10", "3.11", "3.12"],
      "expected_stub_fragments": {
        "3.10": [
          "typing_extensions.Self",
          "@typing_extensions.override",
          "typing_extensions.ReadOnly[int]",
          "typing_extensions.TypeIs[int]"
        ],
        "3.11": [
          "typing.Self",
          "@typing_extensions.override",
          "typing_extensions.ReadOnly[int]",
          "typing_extensions.TypeIs[int]"
        ],
        "3.12": [
          "typing.Self",
          "@typing.override",
          "typing_extensions.ReadOnly[int]",
          "typing_extensions.TypeIs[int]"
        ]
      }
    },
    {
      "name": "toy-task-package",
      "targets": ["3.12"],
      "expected_stub_fragments": {
        "3.12": [
          "def framework_transform(*args, **kwargs): ...",
          "def delay(self, *args: P.args, **kwargs: P.kwargs) -> R: ...",
          "build: Task[[str], int]"
        ]
      }
    },
    {
      "name": "dual-emit-package",
      "targets": ["3.12"],
      "expected_stub_fragments": {
        "3.12": [
          "def fetch_user(client: Client, user_id: str) -> User: ...",
          "async def afetch_user(client: AsyncClient, user_id: str) -> User: ..."
        ]
      }
    },
    {
      "name": "pydantic-like-package",
      "targets": ["3.12"],
      "expected_stub_fragments": {
        "3.12": [
          "class User(BaseModel):",
          "def __init__(self, user_id: int, name: str = ..., tags: object = ...) -> None: ..."
        ]
      }
    },
    {
      "name": "negative-pydantic-strictness-package",
      "targets": ["3.12"],
      "expected_checker_failures": ["mypy", "ty"],
      "allowlist_reason": "mypy and ty intentionally reject this consumer because the fixture exercises stricter constructor expectations than the generated Pydantic-like stub permits",
      "allowlist_expires": "2026-12-31",
      "expected_stub_fragments": {
        "3.12": [
          "class StrictUser(BaseModel):",
          "def __init__(self, user_id: int, name: str, age: int = ...) -> None: ..."
        ]
      }
    },
    {
      "name": "fastapi-like-package",
      "targets": ["3.12"],
      "expected_stub_fragments": {
        "3.12": [
          "class UserCreate(BaseModel):",
          "class UserOut(BaseModel):",
          "def __init__(self, name: str) -> None: ...",
          "def __init__(self, id: int, name: str) -> None: ...",
          "app: FastAPI",
          "@app.post(\"/users\", response_model=UserOut)",
          "def create_user(payload: UserCreate, current_user: CurrentUser = Depends(get_current_user)) -> UserOut: ..."
        ]
      }
    },
    {
      "name": "negative-consumer-package",
      "targets": ["3.10"],
      "expect_checker_failure": true,
      "allowlist_reason": "negative consumer fixture proves downstream checkers reject an intentionally invalid emitted-surface consumer",
      "allowlist_expires": "2026-12-31"
    }
  ]
}
