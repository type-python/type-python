from typing import Callable


class Task[**P, R]:
    def __init__(self, fn: Callable[P, R]) -> None:
        self._fn = fn

    def delay(self, *args: P.args, **kwargs: P.kwargs) -> R:
        return self._fn(*args, **kwargs)


def framework_transform(*args, **kwargs):
    def wrap(fn):
        return fn
    return wrap


@framework_transform(
    kind="function_to_object_decorator",
    capabilities=("function_to_object_replacement", "generic_preservation"),
)
def task[**P, R](fn: Callable[P, R]) -> Task[P, R]:
    return Task[P, R](fn)


@task
def build(name: str) -> int:
    return len(name)


result: int = build.delay("Ada")
