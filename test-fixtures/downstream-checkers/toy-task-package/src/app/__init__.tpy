from typing import Callable, cast


class Task[R]:
    def delay(self, name: str) -> R:
        ...


def framework_transform(*args, **kwargs):
    def wrap(fn):
        return fn
    return wrap


@framework_transform(
    kind="function_to_object_decorator",
    capabilities=("function_to_object_replacement", "generic_preservation"),
)
def task[R](fn: Callable[[str], R]) -> Task[R]:
    return cast(Task[R], Task())


@task
def build(name: str) -> int:
    return len(name)


result: int = build.delay("Ada")
