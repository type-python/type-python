from typing import Any, Callable


def identity_transform[T](obj: T) -> T:
    return obj


def framework_transform[T](*args: object, **kwargs: object) -> Callable[[T], T]:
    return identity_transform


def Field(
    default: object = None,
    default_factory: object = None,
    alias: str | None = None,
    frozen: bool = False,
) -> Any:
    return default


@framework_transform(kind="base_class", capabilities=("field_collection", "constructor_generation", "alias_handling", "required_optional_fields", "readonly_fields"))
class BaseModel:
    pass


class User(BaseModel):
    id: int = Field(alias="user_id", frozen=True)
    name: str = Field(default="Ada")
    tags: object = Field(default_factory=list)
