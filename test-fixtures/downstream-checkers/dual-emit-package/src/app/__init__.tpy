from typing import Callable


def dual_emit[**P, R](fn: Callable[P, R]) -> Callable[P, R]:
    return fn


class User:
    name: str


class Client:
    def get(self, path: str) -> bytes:
        return b""


class AsyncClient:
    async def get(self, path: str) -> bytes:
        return b""


def decode_user(payload: bytes) -> User:
    return User()


@dual_emit
async def fetch_user(client: AsyncClient, user_id: str) -> User:
    payload = await client.get(f"/users/{user_id}")
    return decode_user(payload)
