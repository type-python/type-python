from typing import Literal, TypedDict


class UserRecord(TypedDict):
    id: int
    name: str
    email: str


typealias UserKeys = KeyOf[UserRecord]
typealias FrozenUser = MapValues[UserRecord, Readonly]


def expose_user(user: UserRecord) -> UserRecord:
    return {"id": user["id"], "name": user["name"], "email": user["email"]}


def request_body() -> Tainted[str, "html"]:
    ...


def validate_user_record(value: unknown) -> ValidatorWitness[UserRecord, Literal["trusted"]]:
    ...
